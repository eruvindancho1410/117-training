@model LowStockViewModel
@{
    ViewData["Title"] = "低庫存警示";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">低庫存警示</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">回商品列表</a>
</div>

<form asp-action="LowStock" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-sm-4 col-md-3">
        <label asp-for="Threshold" class="form-label"></label>
        <input asp-for="Threshold" class="form-control" />
        <span asp-validation-for="Threshold" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">查詢</button>
    </div>
</form>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>SKU</th>
            <th>名稱</th>
            <th class="text-end">現有庫存</th>
            <th class="text-end">近 30 天售出數量</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Products.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-center text-muted">沒有符合門檻的商品</td>
            </tr>
        }
        else
        {
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Sku</td>
                    <td>@product.Name</td>
                    <td class="text-end">@product.StockQuantity</td>
                    <td class="text-end">@product.SoldQuantityLast30Days</td>
                </tr>
            }
        }
    </tbody>
</table>
